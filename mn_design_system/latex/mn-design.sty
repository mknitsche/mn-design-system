% --- Schriften: per Pfad aus dem Paket, nie ueber Fontconfig ---------------
\ifx\mndsfontdir\undefined
  \PackageError{mn-design}{\string\mndsfontdir\space ist nicht gesetzt}{Vor \string\usepackage{mn-design} den Schriftordner des Pakets setzen: \string\def\string\mndsfontdir{<mn_design_system.fonts.FONT_DIR>}}
\else\ifx\mndsfontdir\empty
  \PackageError{mn-design}{\string\mndsfontdir\space ist leer}{Den Schriftordner des Pakets uebergeben (mn_design_system.fonts.FONT_DIR)}
\fi\fi
% Grundschrift Geist; Kursiv ist die Editorial-Italic Source Serif 4 (font.family.italic-editorial).
\setmainfont{Geist}[Path=\mndsfontdir/geist/, Extension=.ttf, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=../source-serif/SourceSerif4-Italic, BoldItalicFont=../source-serif/SourceSerif4-BoldItalic]
