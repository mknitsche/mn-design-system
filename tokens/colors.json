    "category": {
      "_meta":     { "value": "To-Do-Prioritaets-Farben fuer PDF-Tabellen (pdf_layer, Aufgaben-Cockpit / Briefing). Option-B Temperatur-Skala (KT-1 S260, Welle 3): vier Prioritaets-Stufen ueber Farb-TEMPERATUR statt vier unverbundener Material-Toene — Sofort=warm-rot, Demnaechst=warm-amber, Klaeren=kuehl-indigo, Irgendwann=neutral-grau. Alle Werte sind Style-Dictionary-Referenzen auf bestehende Marken-Tokens (status / severity / accent.warm / indigo / grey) — keine eigenen Hex-Literale, damit die Prioritaets-Skala automatisch mit der Marke mitwandert. Einzige Ausnahme: prio-sofort-header-text (red-700, kein bestehender Token). v0.12.0 — ersetzt die 11 Material-Design-Adhoc-Tokens aus v0.11.0 (yellow / red-* / yellow-* / blue-* / gray-* / green-cb)." },

      "prio-sofort-bg":          { "value": "{color.status.error-bg.value}",   "comment": "Prioritaet 'Sofort' — Zeilen-Hintergrund (rosa-blass)." },
      "prio-sofort-text":        { "value": "{color.severity.high.value}",     "comment": "Prioritaet 'Sofort' — Zeilen-Text (red-600, leuchtend)." },
      "prio-sofort-header-text": { "value": "#b91c1c",                         "comment": "Prioritaet 'Sofort' — Sektions-Header-Text. Tailwind red-700 — dunkler als severity.high, erreicht >=4.5:1 (5.66:1) auf prio-sofort-bg fuer Kleintext-WCAG-AA. Einziges Hex-Literal der category-Familie: red-700 hat keinen bestehenden Token, fuegt sich aber in die Tailwind-Rot-Skala (severity.high=red-600, status.error=red-ish) ein." },

      "prio-demnaechst-bg":      { "value": "{color.accent.warm.soft.value}",  "comment": "Prioritaet 'Demnaechst' — Zeilen-Hintergrund (amber-100, hell)." },
      "prio-demnaechst-text":    { "value": "{color.accent.warm.text.value}",  "comment": "Prioritaet 'Demnaechst' — Zeilen-Text (amber-900, 8.15:1 auf bg)." },

      "prio-klaeren-bg":         { "value": "{color.indigo.100.value}",        "comment": "Prioritaet 'Klaeren' — Zeilen-Hintergrund (indigo-100, kuehl)." },
      "prio-klaeren-text":       { "value": "{color.indigo.700.value}",        "comment": "Prioritaet 'Klaeren' — Zeilen-Text (indigo-700, 6.41:1 auf bg)." },

      "prio-irgendwann-bg":          { "value": "{color.grey.50.value}",       "comment": "Prioritaet 'Irgendwann' — Zeilen-Hintergrund (grey-50, neutral)." },
      "prio-irgendwann-text":        { "value": "{color.grey.500.value}",      "comment": "Prioritaet 'Irgendwann' — Zeilen-Text (grey-500, unauffaellig)." },
